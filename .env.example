# Copy this file to .env and fill in your own values.
# Both etl_pipeline.py and index.php read these variables.

# MySQL / MariaDB connection
DB_HOST=localhost
DB_NAME=movie_db
DB_USER=root
DB_PASS=
DB_PORT=3306

# TMDB API (https://www.themoviedb.org/settings/api) — required by etl_pipeline.py
TMDB_API_KEY=

# OMDb API (http://www.omdbapi.com/apikey.aspx) — optional, used for supplemental ratings
OMDB_API_KEY=
